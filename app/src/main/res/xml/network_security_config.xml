<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- Permitir solo HTTPS para Cloudinary -->
        <domain includeSubdomains="true">res.cloudinary.com</domain>
        <domain includeSubdomains="true">api.cloudinary.com</domain>

        <!-- Permitir solo HTTPS para Firebase -->
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>

        <!-- Permitir solo HTTPS para Facebook -->
        <domain includeSubdomains="true">graph.facebook.com</domain>
        <domain includeSubdomains="true">facebook.com</domain>

        <!-- Permitir solo HTTPS para Google -->
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
    </domain-config>

    <!-- Configuración base: solo HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>